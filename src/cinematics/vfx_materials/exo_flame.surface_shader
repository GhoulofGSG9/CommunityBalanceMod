<shader>

	<inputs>
		<input name="emissiveMap" type="texture" address="wrap" srgb="true"/>
		<input name="glow" type="float">1.0</input>
		<input name="hiddenAmount" type="float">0.0</input>
	</inputs>

	<code>
	<![CDATA[
		void MaterialShader(in Material_Input input, inout Material material)
		{
			// Must not read as the marine flamethrower by hue alone (colour blind players):
			// the bright part of every particle burns out to white, the rest turns blue.
			float4 tex = tex2D(emissiveMap, input.texCoord);
			float3 c = tex.rgb * input.color.rgb;
			float lum = dot(c, float3(0.299, 0.587, 0.114));
			float core = saturate(lum * 3 - 0.5);
			float3 flame = lerp(float3(0.3, 0.55, 1.0), float3(1.0, 1.0, 1.0), core) * lum * 1.6;
			material.emissive = flame * glow;
			material.opacity  = tex.a * input.color.a * (1 - hiddenAmount);
		}
	]]>
	</code>

</shader>
